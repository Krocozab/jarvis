@echo off
title Jarvis
setlocal EnableExtensions
cd /d "%~dp0"

rem ASCII only: cmd reads .bat in the OEM code page, Russian text breaks parsing.
rem All Russian messages are printed by Python.

where python >nul 2>nul
if errorlevel 1 (
  echo [Jarvis] Python is not in PATH.
  echo Install Python 3.10+ and check "Add python.exe to PATH".
  pause
  exit /b 1
)

if not exist "vendor\vosk" (
  python tools\bootstrap.py
  if errorlevel 1 (
    echo [Jarvis] Dependency setup failed.
    pause
    exit /b 1
  )
)

if /i "%~1"=="check" goto console
if /i "%~1"=="text" goto console

where pythonw >nul 2>nul
if errorlevel 1 goto console_minimized
start "" pythonw -m jarvis
exit /b 0

:console_minimized
start "" /min python -m jarvis
exit /b 0

:console
set "ARGS=%*"
if /i "%~1"=="check" set "ARGS=--check"
if /i "%~1"=="text"  set "ARGS=--text"
python -m jarvis %ARGS%
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" pause
exit /b %RC%
